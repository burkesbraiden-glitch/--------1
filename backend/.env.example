APP_ENV=development
SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/tonglvji?charset=utf8mb4
DEV_FIXED_CODE=123456
CORS_ORIGINS=http://localhost:5173

# Production is WeChat-only. Keep the AppSecret on the backend only.
AUTH_LOGIN_MODE=wechat_only
WECHAT_APP_ID=replace-with-wechat-open-platform-app-id
WECHAT_APP_SECRET=replace-with-wechat-open-platform-app-secret
WECHAT_TIMEOUT_SECONDS=10

# Production must use a self-deployed Edge TTS Worker and a private R2 bucket.
# Set fake explicitly only for local development or testing.
TTS_PROVIDER=edge
EDGE_TTS_BASE_URL=https://replace-with-your-edge-tts-worker.example.com
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_SPEED=1.0
EDGE_TTS_PITCH=0
EDGE_TTS_STYLE=general
EDGE_TTS_TIMEOUT_SECONDS=30
AUDIO_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=replace-with-private-audio-bucket
AUDIO_SIGNED_URL_TTL_SECONDS=300
GUIDE_AUDIO_WORKER_POLL_SECONDS=1

# Legacy phone authentication settings are inactive in production wechat_only mode.
# Do not commit real credentials.
SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=https://replace-with-your-sms-gateway.example.com/send
SMS_HTTP_TOKEN=replace-with-sms-gateway-token
SMS_TEMPLATE_ID=replace-with-login-template-id
SMS_VERIFICATION_SECRET=replace-with-at-least-32-character-secret
SMS_TIMEOUT_SECONDS=10
SMS_CODE_TTL_SECONDS=300
SMS_SEND_COOLDOWN_SECONDS=60
SMS_MAX_VERIFY_ATTEMPTS=5
